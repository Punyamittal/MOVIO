# Copy to .env and adjust as needed
# cp .env.example .env

# Ollama — prefer a small rewrite model; keep TRANSLATOR_OLLAMA_ENABLED=false for low TTFA
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SEC=45

TRANSLATOR_ENABLED=true
TRANSLATOR_OLLAMA_ENABLED=false
DEFAULT_TARGET_LANG=tanglish

# TTS — edge_fast (neural) or win_sapi (local turbo)
DEFAULT_TTS_BACKEND=edge_fast
DEFAULT_VOICE_STYLE=Jaya speaks in a clear, calm, moderate-pitched voice at a moderate pace. The recording is of very high quality with no background noise.

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
QUEUE_ENABLED=true
QUEUE_WORKER_COUNT=1
QUEUE_MAX_SIZE=32
QUEUE_REQUEST_TIMEOUT_SEC=60

# Cache (Phase 2)
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=256

# Optional ASR models for evaluation + two-phone test mode
ASR_PRIMARY_MODEL=ai4bharat/indicwhisper
ASR_FALLBACK_MODEL=openai/whisper-small

# Cost analysis (Phase 4) — set to your real deployment GPU $/hour before finalizing
# Local LOQ ~$0 marginal; cloud T4/A10G roughly $0.50–1.50/hour
HARDWARE_COST_PER_HOUR=1.00

LOG_LEVEL=INFO

# Two-phone test: python -m phone_test
# Use --https if Chrome blocks microphone on LAN HTTP
